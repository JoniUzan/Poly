# Database connection URL
# This should be set in the root .env file to ensure consistency
# The web app will inherit DATABASE_URL from the root .env
#
# For reference:
# SQLite (development):
# DATABASE_URL="file:./packages/database/prisma/dev.db"
#
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/poly_crm"
