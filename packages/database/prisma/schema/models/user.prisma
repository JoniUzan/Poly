// User model for authentication and authorization
//
// ⚠️ SECURITY WARNING:
// The password field MUST store hashed passwords only, never plaintext.
// Use bcrypt or argon2 for password hashing before storing.
//
// Example implementation in user service:
// import bcrypt from 'bcryptjs';
//
// async create(data) {
//   const hashedPassword = await bcrypt.hash(data.password, 10);
//   return prisma.user.create({
//     data: { ...data, password: hashedPassword }
//   });
// }

enum UserRole {
  ADMIN
  MANAGER
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   // ⚠️ MUST be hashed using bcrypt/argon2 before storage
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
